{{/* obsolete mt-* / _shared のみ削除。生成物(bun.lock等)は .chezmoiignore で管理外のため対象外 */ -}}
{{- $home := .chezmoi.homeDir -}}
{{- $src := .chezmoi.sourceDir -}}
{{- $prefix := print $home "/" -}}
{{- $patterns := list
  (joinPath $home ".cursor/skills/*")
  (joinPath $home ".claude/skills/*")
  (joinPath $home ".config/opencode/skills/*")
  (joinPath $home ".tado/workflows/*")
  (joinPath $home ".cursor/agents/*")
  (joinPath $home ".claude/agents/*")
  (joinPath $home ".config/opencode/agents/*")
-}}
{{- range $patterns -}}
{{- range glob . -}}
{{- $rel := trimPrefix $prefix . -}}
{{- $base := base . -}}
{{- /* 生成物は .chezmoiignore で除外済みのため remove 対象外。mt-* / _shared のみ判定 */ -}}
{{- if not (or (hasPrefix "mt-" $base) (eq $base "_shared")) -}}
{{- continue -}}
{{- end -}}
{{- $srcPath := "" -}}
{{- if hasPrefix ".cursor/skills/" $rel -}}
{{- $srcPath = joinPath $src "dot_cursor/skills" $base -}}
{{- else if hasPrefix ".claude/skills/" $rel -}}
{{- $srcPath = joinPath $src "dot_claude/skills" (print "symlink_" $base) -}}
{{- else if hasPrefix ".config/opencode/skills/" $rel -}}
{{- $srcPath = joinPath $src "dot_config/opencode/skills" (print "symlink_" $base) -}}
{{- else if hasPrefix ".tado/workflows/" $rel -}}
{{- $srcPath = joinPath $src "dot_tado/workflows" $base -}}
{{- else if hasPrefix ".cursor/agents/" $rel -}}
{{- $srcPath = joinPath $src "dot_cursor/agents" $base -}}
{{- else if hasPrefix ".claude/agents/" $rel -}}
{{- $srcPath = joinPath $src "dot_claude/agents" $base -}}
{{- else if hasPrefix ".config/opencode/agents/" $rel -}}
{{- $srcPath = joinPath $src "dot_config/opencode/agents" $base -}}
{{- end -}}
{{- if not (stat $srcPath) }}{{ $rel }}{{ "\n" }}{{- end -}}
{{- end -}}
{{- end }}
