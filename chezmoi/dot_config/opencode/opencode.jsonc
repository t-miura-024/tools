{
  "$schema": "https://opencode.ai/config.json",
  "shell": "zsh",
  "agents": {
    "title": {
      "disabled": true
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    },
    "general": {
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Documents/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Desktop/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Downloads/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Pictures/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/Library/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.opencli/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.ssh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.zshrc", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.zsh_secrets.age", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/gh/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.mcp-auth/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.copilot/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.config/configstore/**", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/account.json", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.Trash/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/etc/**", "effect": "deny" },
    { "action": "external_directory", "resource": "/System/**", "effect": "deny" }
  ],
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4-pro": {
          "settings": {
            "reasoningEffort": "high"
          }
        },
        "deepseek-v4-flash": {
          "settings": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
